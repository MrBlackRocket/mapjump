# MapJump – GeoLite2-Country monatliches Update
#
# Einrichtung auf dem Server (KAS Shared Hosting):
#   crontab -e
#   → Diese Zeile einfügen:
#
# ┌─ Minute (23)
# │  ┌─ Stunde (03 Uhr nachts)
# │  │  ┌─ Tag des Monats (1. = erster des Monats)
# │  │  │  ┌─ Monat (jeder)
# │  │  │  │  ┌─ Wochentag (jeder)
# │  │  │  │  │
23  3  1  *  *  /usr/bin/php /www/htdocs/w017d4f9/sonicscrewdriver.mbr.mobi/mapjump/bin/update-geoip.php >> /www/htdocs/w017d4f9/sonicscrewdriver.mbr.mobi/mapjump/logs/geoip-update.log 2>&1

