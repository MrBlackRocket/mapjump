# MapJump – Konfigurationsvorlage
# Kopieren nach config/.env und Werte anpassen

# --- Cache ---
CACHE_DIR=cache/
CACHE_TTL=2592000
CACHE_URL=cache

# --- Zeitzone ---
TIMEZONE=Europe/Berlin

# --- Statische Seiten ---
ALLOWED_VIEWS=hilfe,impressum,datenschutz,lizenz

# --- Sicherheit / Zugriffsschutz ---
ALLOW_EMPTY_REFERRER=false
ALLOWED_REFERRERS=https://example.com
BLACKLISTED_REFERRERS=

# --- GeoIP-Ländersperre ---
# Pfad zur GeoLite2-Country.mmdb (wird per Cron aktualisiert, siehe bin/update-geoip.php)
GEOIP_DB=data/GeoLite2-Country.mmdb
# Kommagetrennte ISO-3166-1-Alpha-2-Ländercodes
BLOCKED_COUNTRIES=

# --- Logging ---
LOGGING_ENABLED=false
LOG_FILE=logs/mapjump.log

# --- Matomo Analytics (optional, leer lassen zum Deaktivieren) ---
MATOMO_URL=
MATOMO_SITE_ID=
