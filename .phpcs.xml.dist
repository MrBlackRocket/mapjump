<?xml version="1.0"?>
<ruleset name="MapJump Ruleset">
  <description>Custom ruleset based on PSR-12 with adjusted exclusions</description>

  <!-- Baseline: PSR-12 -->
  <rule ref="PSR12" />

  <!-- Ausnahmen: Deaktiviere spezifische Regeln -->
  <exclude name="Generic.Files.LineLength.TooLong" />
  <exclude name="Generic.Files.LineLength" />

  <!-- Projektverzeichnis -->
  <file>src</file>
</ruleset>