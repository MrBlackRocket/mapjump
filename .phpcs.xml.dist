<?xml version="1.0"?>
<ruleset name="MapJump Ruleset">
  <description>Custom ruleset based on PSR-12 with adjusted exclusions</description>

  <!-- Baseline: PSR-12 mit Ausnahme für Zeilenlänge (URLs, HTML-Templates) -->
  <rule ref="PSR12">
    <exclude name="Generic.Files.LineLength" />
  </rule>

  <!-- Projektverzeichnis -->
  <file>src</file>
</ruleset>